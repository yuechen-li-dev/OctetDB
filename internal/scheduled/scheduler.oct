package Scheduler

enum SchedulerOutcome {
    Reject
    Wait
    Compatible
    Dispatch
}

fn OutcomeCode(outcome: SchedulerOutcome) -> Int {
    return match outcome {
        case SchedulerOutcome.Reject => 0
        case SchedulerOutcome.Wait => 1
        case SchedulerOutcome.Compatible => 2
        case SchedulerOutcome.Dispatch => 3
    }
}

// SchedulerDecision is a bounded, deterministic control-policy flow. The Go
// integration consumes OutcomeCode's stable scalar projection, while the Oct
// policy retains a closed, exhaustively matched outcome space.
flow SchedulerDecision(used: Int, capacity: Int, requestClass: Int, batchClass: Int, batchCount: Int, maxBatch: Int) -> Int {
    board {
        Decision: Int
    }

    state Idle {
        goto Observe
    }

    state Observe {
        when {
            case used >= capacity -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Reject)
                goto Complete
            }
            else -> goto Queue
        }
    }

    state Queue {
        when {
            case batchCount == 0 -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Wait)
                goto Complete
            }
            case requestClass > 1 -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Wait)
                goto Complete
            }
            case requestClass != batchClass -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Wait)
                goto Complete
            }
            else -> goto BatchReady
        }
    }

    state BatchReady {
        when {
            case batchCount + 1 >= maxBatch -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Dispatch)
                goto Complete
            }
            else -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Compatible)
                goto Complete
            }
        }
    }

    state Complete {
        return board.Decision
    }
}

// UtilityDecision ranks only legal actions. Conflict ownership is an
// authoritative eligibility filter in Go before this policy is called. The
// legal flag also makes that boundary explicit and independently testable.
flow UtilityDecision(legal: Bool, priority: Int, ageMicros: Int, batchCount: Int, maxBatch: Int) -> Int {
    state Eligibility {
        when {
            case legal == false -> return 1
            else -> goto Rank
        }
    }

    state Rank {
        return when policy {
            hysteresis: 8
            min_commit: 3
        } {
            case 2 when ageMicros >= 5000 score 300 + ageMicros
            case 3 when batchCount > 1 score 200 + batchCount
            case 1 when batchCount < maxBatch and ageMicros < 2000 score 150
            case 0 when true score 100 + priority * 10
            else 0
        }
    }
}

// These bounded probes distinguish controller memory from one-shot ranking.
// They run two observations at the same policy site in one persistent flow.
flow PolicyHysteresisProbe(clearWin: Bool) -> Int {
    board {
        Tick: Int
        Chosen: Int
    }
    state Decide {
        board.Chosen = when policy {
            hysteresis: 8
            min_commit: 1
        } {
            case 1 when true score 60
            case 2 when board.Tick > 0 score if clearWin { 80 } else { 65 }
            else 0
        }
        if board.Tick == 1 { return board.Chosen }
        board.Tick = board.Tick + 1
        goto Decide
    }
}

flow PolicyMinCommitProbe() -> Int {
    board {
        Tick: Int
        Chosen: Int
    }
    state Decide {
        board.Chosen = when policy {
            hysteresis: 0
            min_commit: 3
        } {
            case 1 when true score 60
            case 2 when board.Tick > 0 score 100
            else 0
        }
        if board.Tick == 1 { return board.Chosen }
        board.Tick = board.Tick + 1
        goto Decide
    }
}

fn Main() -> Int {
    let controller = SchedulerDecision(0, 64, 0, 0, 0, 8)
    Step(controller)
    return 0
}
