package Scheduler

enum SchedulerOutcome {
    Reject
    Wait
    Compatible
    Dispatch
}

fn OutcomeCode(outcome: SchedulerOutcome) -> Int {
    return match outcome {
        case SchedulerOutcome.Reject => 0
        case SchedulerOutcome.Wait => 1
        case SchedulerOutcome.Compatible => 2
        case SchedulerOutcome.Dispatch => 3
    }
}

// SchedulerDecision is a bounded, deterministic control-policy flow. The Go
// integration consumes OutcomeCode's stable scalar projection, while the Oct
// policy retains a closed, exhaustively matched outcome space.
flow SchedulerDecision(used: Int, capacity: Int, requestClass: Int, batchClass: Int, batchCount: Int, maxBatch: Int) -> Int {
    board {
        Decision: Int
    }

    state Idle {
        goto Observe
    }

    state Observe {
        when {
            case used >= capacity -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Reject)
                goto Complete
            }
            else -> goto Queue
        }
    }

    state Queue {
        when {
            case batchCount == 0 -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Wait)
                goto Complete
            }
            case requestClass > 1 -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Wait)
                goto Complete
            }
            case requestClass != batchClass -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Wait)
                goto Complete
            }
            else -> goto BatchReady
        }
    }

    state BatchReady {
        when {
            case batchCount + 1 >= maxBatch -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Dispatch)
                goto Complete
            }
            else -> {
                board.Decision = OutcomeCode(SchedulerOutcome.Compatible)
                goto Complete
            }
        }
    }

    state Complete {
        return board.Decision
    }
}

// F0: one controller belongs to one centralized scheduler. Go updates this
// board before every Step; the instance survives for the scheduler lifetime.
flow PersistentParityController() -> Int {
    board {
        OldestEligible: Bool
        Chosen: Int
        Decisions: Int
    }
    state Decide {
        board.Chosen = when policy {
            hysteresis: 0
            min_commit: 1
        } {
            case 0 when board.OldestEligible score 1
            else 4
        }
        board.Decisions = board.Decisions + 1
        suspend
        goto Decide
    }
}

// F1 ranks only summaries of candidates already proven legal by Go. Choice 2
// is the starvation override; commitment and hysteresis govern ordinary choice.
flow PersistentFairController() -> Int {
    board {
        OldestEligible: Bool
        HighEligible: Bool
        AgedEligible: Bool
        BatchEligible: Bool
        OldestScore: Int
        HighScore: Int
        BatchScore: Int
        Chosen: Int
        Decisions: Int
    }
    state Decide {
        if board.AgedEligible {
            board.Chosen = 2
        } else {
            board.Chosen = when policy {
                hysteresis: 25
                min_commit: 2
            } {
                case 1 when board.HighEligible score board.HighScore
                case 3 when board.BatchEligible score board.BatchScore
                case 0 when board.OldestEligible score board.OldestScore
                else 4
            }
        }
        board.Decisions = board.Decisions + 1
        suspend
        goto Decide
    }
}

fn Main() -> Int {
    let controller = SchedulerDecision(0, 64, 0, 0, 0, 8)
    Step(controller)
    return 0
}
